# Generate a random number; optionally write and publish it to GitHub.
# Safe default: print only, without changing files or calling Git.
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
output="$ROOT/random_Num"
threshold=4
write=false
publish=false
override=''
custom_output=false

usage() {
    printf 'Usage: %s [--write] [--publish] [--threshold 1..10] [--output FILE] [--number 1..10]\n' "${0##*/}"
    printf 'Default: preview only. --publish implies --write and pushes to origin.\n'
}
while (( $# )); do
    case "$1" in
        --write) write=true; shift ;;
        --publish) write=true; publish=true; shift ;;
        --threshold|--output|--number)
            (( $# >= 2 )) || { usage >&2; exit 2; }
            case "$1" in
                --threshold) threshold="$2" ;;
                --output) output="$2"; custom_output=true ;;
                --number) override="$2" ;;
            esac
            shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
valid_number() {
    [[ "$1" =~ ^(10|[1-9])$ ]]
}
if ! valid_number "$threshold" ||
   { [[ -n "$override" ]] && ! valid_number "$override"; }; then
    printf 'Error: threshold/number must be 1–10.\n' >&2
    exit 2
fi
if $publish && { $custom_output || [[ -n "$override" ]]; }; then
    printf 'Error: publishing requires the default file and genuine randomness.\n' >&2
    exit 2
fi
number="${override:-$(python3 -c 'import secrets; print(secrets.randbelow(10) + 1)')}"
printf 'Random number: %s\n' "$number"
if (( number < threshold )); then
    printf 'Below threshold %d; no file or Git changes.\n' "$threshold"
    exit 0
fi
if ! $write; then
    printf 'Preview only; pass --write or --publish to save.\n'
    exit 0
fi
if [[ -L "$output" || ( -e "$output" && "$output" != "$ROOT/random_Num" ) ]]; then
    printf 'Error: refusing to overwrite an existing or symlinked custom file.\n' >&2
    exit 2
fi
mkdir -p -- "$(dirname -- "$output")"
printf '%s\n' "$number" > "$output"
printf 'Saved to %s\n' "$output"
if ! $publish; then
    exit 0
fi
if ! git -C "$ROOT" diff --quiet -- random_Num; then
    git -C "$ROOT" add -- random_Num
    git -C "$ROOT" commit -m "Update random number"
    branch="$(git -C "$ROOT" branch --show-current)"
    [[ -n "$branch" ]] || { printf 'Error: detached HEAD.\n' >&2; exit 2; }
    git -C "$ROOT" push origin "$branch"
else
    printf 'No Git changes; nothing to publish.\n'
fi
